{
  "name": "VideoProgress",
  "type": "object",
  "properties": {
    "video_id": {
      "type": "string",
      "description": "Stable identifier of the video (matches library id)"
    },
    "position": {
      "type": "number",
      "description": "Last playback position in seconds",
      "default": 0
    },
    "duration": {
      "type": "number",
      "description": "Total video duration in seconds"
    },
    "completed": {
      "type": "boolean",
      "description": "Whether the user finished the video",
      "default": false
    },
    "last_watched": {
      "type": "string",
      "format": "date",
      "description": "Date the video was last watched"
    },
    "title": {
      "type": "string",
      "description": "Video title (denormalized for history)"
    },
    "topic": {
      "type": "string",
      "description": "Topic / course id the video belongs to"
    },
    "description": {
      "type": "string",
      "description": "Optional notes or description for this video progress record",
      "maxLength": 1000
    }
  },
  "required": [
    "video_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
{
  "name": "PaperTrade",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "description": "Trading symbol e.g. AAPL, BTC"
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ],
      "description": "Trade direction"
    },
    "quantity": {
      "type": "number",
      "description": "Number of shares/units"
    },
    "entry_price": {
      "type": "number",
      "description": "Price at which trade was entered"
    },
    "current_price": {
      "type": "number",
      "description": "Latest price for P&L calc"
    },
    "exit_price": {
      "type": "number",
      "description": "Price at which trade was closed"
    },
    "stop_loss": {
      "type": "number",
      "description": "Stop loss price"
    },
    "take_profit": {
      "type": "number",
      "description": "Take profit price"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "cancelled"
      ],
      "default": "open"
    },
    "pnl": {
      "type": "number",
      "description": "Realized or unrealized P&L in USD"
    },
    "pnl_percent": {
      "type": "number",
      "description": "P&L as percentage"
    },
    "notes": {
      "type": "string",
      "description": "Optional trade notes"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "stock",
        "crypto",
        "forex",
        "commodity"
      ],
      "default": "stock"
    }
  },
  "required": [
    "symbol",
    "side",
    "quantity",
    "entry_price"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}